{
  "compilerOptions": {
    "composite": true,
    // A referenced composite project may not set noEmit (TS6310), so send the
    // output somewhere harmless instead. Left in the project root, the emitted
    // vite.config.js would be loaded by Vite in preference to vite.config.ts.
    "outDir": "./node_modules/.tmp/node-build",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
